{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tehran-network-installer",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "assets": {
    "directory": "../installer/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
}
