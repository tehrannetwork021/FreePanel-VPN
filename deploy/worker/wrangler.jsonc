{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tehran-network-edge-panel",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "secrets": {
    "required": ["ADMIN_PASSWORD"],
  },
  "kv_namespaces": [
    {
      "binding": "C",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
